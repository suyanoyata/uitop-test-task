generator client {
  provider = "prisma-client-js"
  output   = "../lib/db"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Task {
  id        Int       @id @default(autoincrement())
  title     String
  completed Boolean   @default(false)
  deletedAt DateTime?

  category Category @relation(fields: [categoryId], references: [id])

  categoryId Int

  @@map("task")
}

model Category {
  id    Int    @id @default(autoincrement())
  title String

  Task Task[]

  @@map("category")
}
